# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Use a bare model with exactly one provider key, or provider:model when keys are ambiguous.
# Examples: text-embedding-3-small, openai:text-embedding-3-small,
# openrouter:openai/text-embedding-3-small, gemini:gemini-embedding-001.
EMBEDDING_MODEL=
# Optional for models whose dimensions cannot be inferred by the adapter.
EMBEDDING_DIMENSIONS=
# Chat model on the same provider as the configured API key.
# Examples: openai/gpt-4o-mini (OpenRouter), gpt-4o-mini (OpenAI), gemini-2.0-flash.
CHAT_MODEL=
